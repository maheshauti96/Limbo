<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.maheshauti.session-watcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/maheshauti/bin/session-watcher</string>
    <string>watch</string>
    <string>-interval</string>
    <string>250ms</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/maheshauti/Library/Logs/session-watcher/watch.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/maheshauti/Library/Logs/session-watcher/watch.stderr.log</string>
</dict>
</plist>
